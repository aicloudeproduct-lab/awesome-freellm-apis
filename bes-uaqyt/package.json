{
  "name": "bes-uaqyt",
  "version": "1.0.0",
  "private": true,
  "description": "Bes uaqyt \u2014 cinematic minimalist motion piece (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "audio": "python3 tools/make_audio.py",
    "preview": "remotion render BesUaqyt output/preview.mp4 --scale=0.5 --every-nth-frame=2 --crf=26 --muted",
    "render": "bash tools/render_final.sh",
    "check": "esbuild tools/check-rig.ts --bundle --platform=node --format=esm --log-level=warning --outfile=build/check-rig.mjs && node build/check-rig.mjs",
    "events": "esbuild tools/export-events.ts --bundle --platform=node --format=esm --log-level=warning --outfile=build/export-events.mjs && node build/export-events.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}