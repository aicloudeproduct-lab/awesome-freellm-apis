{
  "name": "my-animation2",
  "version": "1.0.0",
  "private": true,
  "description": "Premium cinematic iPad animation (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "preview": "remotion render IpadCinematic out/preview_1024x768.mp4 --scale=0.5 --crf=20",
    "render": "remotion render IpadCinematic out/ipad_cinematic_final.mp4 --codec=h264 --crf=17"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
