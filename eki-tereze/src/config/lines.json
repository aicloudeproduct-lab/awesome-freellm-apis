      ],
      "gap": 0.4
    },
    {
      "id": "n6",
      "who": "narrator",
      "at": 55.6,
      "parts": [
        "Қызғаныш үнсіз келеді.",
        "Алдымен — салыстыру.",
        "Сосын — алыстау."
