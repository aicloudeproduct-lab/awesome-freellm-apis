      "gap": 0.3
    },
    {
      "id": "n3",
      "who": "narrator",
      "at": 25.6,
      "parts": [
        "Бір күні екеуі бір байқауға қатысты.",
        "Жеңіс Аянға бұйырды."
      ],
      "gap": 0.35
    },
    {
      "id": "a1",
      "who": "arman",
      "at": 31.4,
      "parts": [
        "Құттықтаймын, досым!",
        "Келесі жолы мен жеңемін."
      ],
      "gap": 0.45
    },
    {
      "id": "n4",
      "who": "narrator",
      "at": 37.2,
      "parts": [
        "Адал бәсеке адамды өсіреді.",
        "Арман да өз жолын жалғастырды."
      ],
      "gap": 0.35
    },
    {
      "id": "n5",
      "who": "narrator",
      "at": 46.6,
      "parts": [
        "Әркімнің несібесі өзіне берілген.",
